local BackgroundImageId = ""
local themeCounter = 0

local function BuildHub()
    local WindUI = LoadWindUI()
    if not WindUI then error("WindUI não pôde ser carregada") end

    SetGlobal("EnderHub_WindUI", WindUI)

    local function MakeWindow(withBg)
        local cfg = {
            Title = "Ender Hub",
            Icon = "biohazard",
            Author = "by Dreyko",
            Folder = "EnderHub",
            Size = UDim2.fromOffset(600, 460),
            Transparent = true,
            Theme = "Dark",
            Resizable = true,
            SideBarWidth = 200,
            HideSearchBar = true,
            ScrollBarEnabled = true,
            KeySystem = {
                Enabled = true,
                Title = "Key System",
                Subtitle = "Insira a key para acessar",
                Key = { "2002brasil" },
                SaveKey = false,
                SaveKeyLocal = false,
                SaveKeyName = "EnderHubKey",
                Notify = true,
                Icon = "key",
            },
        }
        if withBg and BackgroundImageId ~= "" then
            cfg.Background = "rbxassetid://" .. BackgroundImageId
            cfg.BackgroundImageTransparency = 0.35
        end
        return WindUI:CreateWindow(cfg)
    end

    local okWin, Window = pcall(MakeWindow, true)
    if not okWin or not Window then
        warn("[EnderHub] Janela com fundo falhou: " .. tostring(Window))
        okWin, Window = pcall(MakeWindow, false)
    end
    if not okWin or not Window then error("Não foi possível criar a janela: " .. tostring(Window)) end

    print("[EnderHub] ✓ Janela criada")

    local tagsList = {}
    local function CreateTag(t, i, c)
        local ok, o = pcall(function()
            return Window:Tag({ Title = t, Icon = i, Color = c, Radius = 0 })
        end)
        if ok and o then table.insert(tagsList, o) end
    end

    CreateTag("v1.6.6", "biohazard", Accent)
    CreateTag("Brasil", "flag", Accent)
    CreateTag("Apelão", "zap", Accent)

    local function SetTagsColor(newColor)
        for _, tag in ipairs(tagsList) do
            pcall(function()
                if tag.SetColor then tag:SetColor(newColor) end
            end)
        end
    end

    -- ABAS (com pcall individual)
    local MainTab, LegendaryTab, HelpTab, CreditsTab

    pcall(function() MainTab = Window:Tab({ Title = "Início", Icon = "home" }) end)
    pcall(function() LegendaryTab = Window:Tab({ Title = "Legendary Atravessar", Icon = "ghost" }) end)
    pcall(function() HelpTab = Window:Tab({ Title = "Dúvidas", Icon = "circle-help" }) end)
    pcall(function() CreditsTab = Window:Tab({ Title = "Créditos", Icon = "sparkles" }) end)

    print("[EnderHub] ▶ Abas:",
        MainTab and "Início✓" or "Início✗",
        LegendaryTab and "Legendary✓" or "Legendary✗",
        HelpTab and "Dúvidas✓" or "Dúvidas✗",
        CreditsTab and "Créditos✓" or "Créditos✗"
    )

    ----------------------------------------------------------
    -- ABA DÚVIDAS
    ----------------------------------------------------------
    if HelpTab then
        pcall(function()
            HelpTab:Paragraph({
                Title = "Tem dúvidas?",
                Desc = "Fale com os donos do Ender Hub! Copie os contatos abaixo.",
                Image = "circle-help",
            })
        end)

        pcall(function()
            HelpTab:Button({
                Title = "📋 Copiar Discord",
                Desc = "Discord: " .. DISCORD_HANDLE,
                Callback = function()
                    local ok = CopyToClipboard(DISCORD_HANDLE)
                    if ok then
                        CustomNotify({ Title = "Copiado!", Content = "Discord: " .. DISCORD_HANDLE, Icon = "💬", Duration = 3 })
                    else
                        CustomNotify({ Title = "Erro ao copiar", Content = "Executor sem setclipboard.", Icon = "❌", Color = Danger, Duration = 4 })
                    end
                end,
            })
        end)

        pcall(function()
            HelpTab:Button({
                Title = "📋 Copiar TikTok",
                Desc = "TikTok: " .. TIKTOK_HANDLE,
                Callback = function()
                    local ok = CopyToClipboard(TIKTOK_HANDLE)
                    if ok then
                        CustomNotify({ Title = "Copiado!", Content = "TikTok: " .. TIKTOK_HANDLE, Icon = "🎵", Duration = 3 })
                    else
                        CustomNotify({ Title = "Erro ao copiar", Content = "Executor sem setclipboard.", Icon = "❌", Color = Danger, Duration = 4 })
                    end
                end,
            })
        end)

        pcall(function()
            HelpTab:Button({
                Title = "📋 Copiar os dois juntos",
                Desc = "Copia Discord + TikTok de uma vez",
                Callback = function()
                    local text = string.format("Discord: %s\nTikTok: %s", DISCORD_HANDLE, TIKTOK_HANDLE)
                    local ok = CopyToClipboard(text)
                    if ok then
                        CustomNotify({ Title = "Copiado!", Content = "Discord + TikTok copiados.", Icon = "📋", Duration = 3 })
                    else
                        CustomNotify({ Title = "Erro ao copiar", Content = "Executor sem setclipboard.", Icon = "❌", Color = Danger, Duration = 4 })
                    end
                end,
            })
        end)

        pcall(function()
            HelpTab:Paragraph({
                Title = "Sobre o Hub",
                Desc = "Ender Hub é feito por Loved Filho (UI), Dreyko (Script Maker) e teddy (Developer).",
                Image = "info",
            })
        end)
    end

    ----------------------------------------------------------
    -- ABA LEGENDARY
    ----------------------------------------------------------
    if LegendaryTab then
        pcall(function()
            LegendaryTab:Paragraph({
                Title = "Legendary Atravessar",
                Desc = "Clique no botão abaixo para abrir o Legendary Hub (ele pede a key ao abrir).",
                Image = "ghost",
            })
        end)
        pcall(function()
            LegendaryTab:Button({
                Title = "Executar Legendary",
                Desc = "Abre o Legendary Hub",
                Callback = function()
                    local ok, err = pcall(RunLegendary)
                    if ok then
                        CustomNotify({ Title = "Legendary", Content = "Legendary Hub executado!", Icon = "👻", Duration = 3 })
                    else
                        warn("[EnderHub] Erro Legendary: " .. tostring(err))
                        CustomNotify({ Title = "Legendary • Erro", Content = tostring(err):sub(1, 90), Icon = "❌", Color = Danger, Duration = 8 })
                    end
                end,
            })
        end)
    end

    ----------------------------------------------------------
    -- ABA INÍCIO
    ----------------------------------------------------------
    if MainTab then
        pcall(function()
            MainTab:Paragraph({
                Title = "Ender Hub",
                Desc = "Hub carregado com sucesso. Use as abas do menu lateral para navegar pelos recursos.",
                Image = "biohazard",
            })
        end)

        pcall(function()
            MainTab:Toggle({
                Title = "Ativar efeitos visuais",
                Desc = "Liga/desliga efeitos visuais do Hub",
                Default = false,
                Callback = function(state)
                    CustomNotify({
                        Title = "Ender Hub",
                        Content = state and "Efeitos visuais ativados" or "Efeitos visuais desativados",
                        Icon = state and "✨" or "🚫",
                        Duration = 3,
                    })
                end,
            })
        end)

        -- SPEED 24
        local speedConn, speedEnabled, originalSpeed = nil, false, 16
        pcall(function()
            MainTab:Toggle({
                Title = "Speed 24 Disfarçado",
                Desc = "Funciona tanto Pc e mobile",
                Default = false,
                Callback = function(state)
                    speedEnabled = state
                    if speedConn then speedConn:Disconnect(); speedConn = nil end
                    if state then
                        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if h then originalSpeed = h.WalkSpeed end
                        speedConn = RunService.RenderStepped:Connect(function()
                            local h2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if speedEnabled and h2 then h2.WalkSpeed = 24 end
                        end)
                        CustomNotify({ Title = "Speed Disfarçado", Content = "Speed 24 ativado!", Icon = "⚡", Duration = 3 })
                    else
                        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if h then h.WalkSpeed = originalSpeed end
                        CustomNotify({ Title = "Speed Disfarçado", Content = "Velocidade normal restaurada.", Icon = "🛑", Duration = 3 })
                    end
                end,
            })
        end)

        -- ANTI-PULO
        local jumpConn, antiJumpEnabled, oJP, oJH = nil, false, 50, 7.2
        pcall(function()
            MainTab:Toggle({
                Title = "Anti-Pulo",
                Desc = "Funciona tanto Pc e Mobile",
                Default = false,
                Callback = function(state)
                    antiJumpEnabled = state
                    if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
                    if state then
                        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if h then
                            if h.UseJumpPower then oJP = h.JumpPower else oJH = h.JumpHeight end
                        end
                        jumpConn = RunService.RenderStepped:Connect(function()
                            local h2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if antiJumpEnabled and h2 then
                                if h2.UseJumpPower then h2.JumpPower = 0 else h2.JumpHeight = 0 end
                            end
                        end)
                        CustomNotify({ Title = "Anti-Pulo", Content = "Pulo desativado!", Icon = "🚫", Duration = 3 })
                    else
                        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if h then
                            if h.UseJumpPower then h.JumpPower = oJP else h.JumpHeight = oJH end
                        end
                        CustomNotify({ Title = "Anti-Pulo", Content = "Pulo restaurado.", Icon = "🦘", Duration = 3 })
                    end
                end,
            })
        end)

        -- COR DA UI
        pcall(function()
            MainTab:Dropdown({
                Title = "Cor da UI",
                Desc = "Personalize o Hub e as Tags",
                Values = ColorNames,
                Callback = function(selected)
                    local key = selected
                    if type(selected) == "table" then key = selected[1] or selected[#selected] end
                    if type(key) ~= "string" then return end
                    local chosen = ColorMap[key]
                    if not chosen then return end

                    themeCounter += 1
                    local themeName = "EnderCustom" .. themeCounter

                    pcall(function()
                        if WindUI.AddTheme then
                            WindUI:AddTheme({
                                Name = themeName,
                                Accent = chosen,
                                Dialog = Color3.fromRGB(20, 20, 24),
                                Outline = chosen,
                                Text = Color3.fromRGB(240, 240, 240),
                                Placeholder = Color3.fromRGB(150, 150, 150),
                                Background = Color3.fromRGB(15, 15, 18),
                                Button = chosen,
                                Icon = chosen,
                            })
                        end
                    end)
                    pcall(function()
                        if WindUI.SetTheme then WindUI:SetTheme(themeName) end
                    end)

                    SetTagsColor(chosen)
                    CustomNotify({ Title = "Ender Hub", Content = "Cor alterada para " .. key, Icon = "🎨", Color = chosen, Duration = 3 })
                end,
            })
        end)
    end

    ----------------------------------------------------------
    -- ABA CRÉDITOS
    ----------------------------------------------------------
    if CreditsTab then
        pcall(function()
            CreditsTab:Paragraph({ Title = "UI Designer", Desc = "Loved Filho 🎨 — cria o visual da interface.", Image = "paintbrush" })
        end)
        pcall(function()
            CreditsTab:Paragraph({ Title = "Script Maker", Desc = "Dreyko 🖥️ — cria novas funções e recursos.", Image = "code" })
        end)
        pcall(function()
            CreditsTab:Paragraph({ Title = "Script Developer", Desc = "teddy ⚒️ — cria, atualiza e corrige bugs.", Image = "wrench" })
        end)
    end

    task.wait(0.3)
    CustomNotify({
        Title = "Ender Hub",
        Content = "Script carregado! Versão v1.6.6 | Key: 2002brasil",
        Icon = "✅",
        Duration = 5,
    })
end

