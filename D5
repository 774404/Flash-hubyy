local function GetWUI()
    if WUI_CACHE then return WUI_CACHE end
    local cached = GG("EH_WUI")
    if cached then WUI_CACHE = cached; return cached end
    for _, url in ipairs(WUI_URLS) do
        local ok, lib = pcall(function() return loadstring(game:HttpGet(url))() end)
        if ok and lib then
            WUI_CACHE = lib; SG("EH_WUI", lib)
            print("[EnderHub] ✓ WindUI carregada")
            return lib
        end
    end
    error("WindUI não pôde ser carregada (HttpGet/loadstring necessário)")
