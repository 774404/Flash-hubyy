local function AfterHubBuilt()
    if not HasFirstRunBeenShown() then
        print("[EnderHub] ▶ Mostrando popup de primeira vez...")
        task.wait(0.6)
        ShowFirstRunPrompt(function(wantsToCopy)
            if wantsToCopy then
                local text = string.format("Discord: %s\nTikTok: %s", DISCORD_HANDLE, TIKTOK_HANDLE)
                local ok = CopyToClipboard(text)
                if ok then
                    CustomNotify({ Title = "Contatos copiados!", Content = "Discord e TikTok copiados.", Icon = "📋", Duration = 5 })
                else
                    CustomNotify({ Title = "Não foi possível copiar", Content = "Use a aba Dúvidas do Hub.", Icon = "❌", Color = Danger, Duration = 6 })
                end
            end
            SaveFirstRunShown()
        end)
    else
        print("[EnderHub] ▶ Popup primeira vez já mostrado antes.")
    end
end

local function StartHub()
    print("[EnderHub] ▶ StartHub iniciado")
    CustomNotify({
        Title = "Ender Hub",
        Content = "A UI pode demorar um pouco para carregar. Aguarde com calma! ⏳",
        Icon = "⚠️",
        Color = Warn,
        Duration = 6,
    })
    task.wait(1)

    local ok, err = pcall(function()
        ShowLoadingScreen(function()
            print("[EnderHub] ▶ Loading terminou")
            SafeBuildHub()
            AfterHubBuilt()
        end)
    end)
    if not ok then
        warn("[EnderHub] ✗ Erro na loading: " .. tostring(err))
        SafeBuildHub()
        AfterHubBuilt()
    end
end

