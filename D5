local function SafeBuild()
    print("[EnderHub] ▶ Construindo hub...")
    local ok, err = pcall(Build)
    if not ok then
        warn("[EnderHub] ✗ Erro: " .. tostring(err))
        pcall(function()
            Notify({ Title = "Erro no Hub", Content = tostring(err):sub(1, 90), Icon = "❌", Color = Danger, Duration = 10 })
        end)
    else
        print("[EnderHub] ✓ Hub pronto!")
    end
end

