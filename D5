local GlobalStore = {}
local function SetGlobal(key, value)
    GlobalStore[key] = value
    pcall(function() getgenv()[key] = value end)
    pcall(function() _G[key] = value end)
end

local function GetGlobal(key)
    if GlobalStore[key] ~= nil then return GlobalStore[key] end
    local v
    pcall(function() v = getgenv()[key] end)
    if v ~= nil then return v end
    pcall(function() v = _G[key] end)
    return v
end

