local function TW(o,t,p,s,d)
    local x = TweenService:Create(o, TweenInfo.new(t or .3, s or Enum.EasingStyle.Quad, d or Enum.EasingDirection.Out), p)
    x:Play(); return x
end
local function CR(p,r) local c=Instance.new("UICorner"); c.CornerRadius=r or UDim.new(0,10); c.Parent=p; return c end
local function ST(p,c,t,tr)
    local s=Instance.new("UIStroke"); s.Color=c or Accent; s.Thickness=t or 1.5; s.Transparency=tr or .2
    s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; s.Parent=p; return s
end
local function CB(txt)
    return pcall(function()
        if setclipboard then setclipboard(txt)
        elseif toclipboard then toclipboard(txt)
        else error("sem setclipboard") end
    end)
end

