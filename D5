local ColorNames = {}
local ColorMap = {}
do
    local palette = {
        "Vermelho", "Coral", "Laranja", "Âmbar", "Dourado", "Amarelo", "Limão", "Verde Neon",
        "Verde", "Esmeralda", "Menta", "Turquesa", "Ciano", "Azul Céu", "Azul", "Azul Royal",
        "Índigo", "Violeta", "Roxo", "Magenta", "Rosa", "Pink", "Carmim", "Salmão",
    }
    for i = 1, 120 do
        local c = Color3.fromHSV((i - 1) / 120, 0.7, 1)
        local label = string.format("%s %03d", palette[((i - 1) % #palette) + 1], i)
        table.insert(ColorNames, label)
        ColorMap[label] = c
    end
end

