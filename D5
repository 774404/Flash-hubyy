local function AfterBuild()
    if not HasFirstRun() then
        print("[EnderHub] ▶ Popup primeira vez...")
        task.wait(0.6)
        FRPrompt(function(want)
            if want then
                local t = "Discord: " .. DISCORD .. "\nTikTok: " .. TIKTOK
                if CB(t) then
                    Notify({ Title = "Copiado!", Content = "Discord + TikTok copiados.", Icon = "📋", Duration = 5 })
                else
                    Notify({ Title = "Erro", Content = "Use a aba Dúvidas.", Icon = "❌", Color = Danger, Duration = 6 })
                end
            end
            SaveFirstRun()
        end)
    end
end

local function Start()
    print("[EnderHub] ▶ StartHub")
    Notify({
        Title = "Ender Hub",
        Content = "A UI pode demorar um pouco. Aguarde com calma! ⏳",
        Icon = "⚠️", Color = Warn, Duration = 6,
    })
    task.wait(1)

    local ok, err = pcall(function()
        Loading(function()
            SafeBuild()
            AfterBuild()
        end)
    end)
    if not ok then
        warn("[EnderHub] Erro loading: " .. tostring(err))
        SafeBuild()
        AfterBuild()
    end
end

print("[EnderHub] ▶ Verificando whitelist salva...")
if HasAccepted() then
    Start()
else
    WLPrompt(function(a)
        if not a then
            Notify({ Title = "Ender Hub", Content = "Acesso recusado.", Icon = "🚫", Color = Danger, Duration = 4 })
            return
        end
        SaveAccepted()
        Start()
    end)
end
