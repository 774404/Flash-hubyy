local SAVE_FILE_FIRSTRUN  = SAVE_FOLDER .. "/primeira_execucao.txt"
local saveKey = tostring(LocalPlayer.UserId)

local function EnsureFolder()
    pcall(function()
        if makefolder and isfolder and not isfolder(SAVE_FOLDER) then
            makefolder(SAVE_FOLDER)
        end
    end)
end

local function HasAcceptedBefore()
    local env = GetGlobal("EnderHub_Aceito")
    if env == saveKey then return true end
    local ok, c = pcall(function()
        if isfile and readfile and isfile(SAVE_FILE_WHITELIST) then return readfile(SAVE_FILE_WHITELIST) end
    end)
    return ok and c == saveKey
end

local function SaveAccepted()
    EnsureFolder()
    SetGlobal("EnderHub_Aceito", saveKey)
    pcall(function()
        if writefile then writefile(SAVE_FILE_WHITELIST, saveKey) end
    end)
end

