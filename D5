local GS = {}
local function SG(k,v) GS[k]=v; pcall(function() getgenv()[k]=v end); pcall(function() _G[k]=v end) end
local function GG(k)
    if GS[k]~=nil then return GS[k] end
    local v; pcall(function() v=getgenv()[k] end); if v~=nil then return v end
    pcall(function() v=_G[k] end); return v
end

